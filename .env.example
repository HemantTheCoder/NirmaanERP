# Supabase environment variables
# Copy this file to .env.local and fill in your project values
# Get these from: https://supabase.com/dashboard → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Cloudflare Turnstile — bot protection on signup
# Site key is public (safe in client bundles). Secret key is not — get both
# from the Cloudflare dashboard under Turnstile > your widget.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key
# Comma-separated production hostnames siteverify should accept (no localhost).
# Skipped automatically outside production, so leave unset for local dev.
TURNSTILE_HOSTNAMES=your-production-domain.vercel.app

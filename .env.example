# Supabase environment variables
# Copy this file to .env.local and fill in your project values
# Get these from: https://supabase.com/dashboard → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Cloudflare Turnstile — bot protection on signup/login/password reset
# Site key is public (safe in client bundles) and is the only piece this app
# reads — the token is verified by Supabase Auth's own Captcha Protection
# setting (Dashboard > Authentication > Attack Protection), configured with
# the matching Turnstile secret key there, not in this app's env.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key

# Gemini API key — powers the "AI Draft" button on the Daily Progress
# Report form. Free tier available via Google AI Studio:
# https://aistudio.google.com/apikey
# Optional: omitted, the button just returns a clear "not configured" error
# instead of failing the rest of the app.
GEMINI_API_KEY=your-gemini-api-key
